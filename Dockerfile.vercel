FROM python:3.12-slim

WORKDIR /app

COPY streamlit_app.py flood_api.py ./
COPY .streamlit ./.streamlit

RUN pip install --no-cache-dir --root-user-action=ignore \
    "python-dotenv>=1.0.0" \
    "requests>=2.32.0" \
    "streamlit>=1.61.0"

EXPOSE 80

CMD ["sh", "-c", "streamlit run streamlit_app.py --server.port=${PORT:-80} --server.address=0.0.0.0 --server.headless=true --browser.gatherUsageStats=false"]
